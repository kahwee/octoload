{
  "name": "octoload",
  "version": "0.1.8",
  "type": "module",
  "description": "Minimal, composable image upload system with CLI for generating Drizzle schemas and typed clients",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "octoload": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.js"
    },
    "./react-router": {
      "types": "./dist/adapters/react-router.d.ts",
      "import": "./dist/adapters/react-router.js",
      "require": "./dist/adapters/react-router.js"
    },
    "./nextjs": {
      "types": "./dist/adapters/nextjs.d.ts",
      "import": "./dist/adapters/nextjs.js",
      "require": "./dist/adapters/nextjs.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:generate-templates && pnpm run build:compile",
    "build:clean": "rm -rf dist",
    "build:generate-templates": "node scripts/generate-template.js",
    "build:compile": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check .",
    "fix": "pnpm run lint:fix && pnpm run format",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc",
    "update-all-package": "pnpm dlx npm-check-updates -u && pnpm install",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run build"
  },
  "keywords": [
    "image",
    "upload",
    "drizzle",
    "s3",
    "r2",
    "cloudflare",
    "presigned-url",
    "typescript",
    "cli",
    "react-router",
    "nextjs",
    "file-upload",
    "direct-upload",
    "multipart",
    "storage"
  ],
  "author": "KahWee Teng <tengkahwee@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kahwee/octoload#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/octoload.git"
  },
  "bugs": {
    "url": "https://github.com/kahwee/octoload/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.927.0",
    "commander": "^14.0.2",
    "drizzle-orm": "^0.44.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "next": "^16.0.1",
    "prettier": "^3.6.2",
    "react-router": "^7.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.0"
  },
  "files": [
    "dist/**/*",
    "templates/**/*",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ]
}
