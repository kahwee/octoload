{
  "name": "octoload",
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal, composable image upload system with CLI for generating Drizzle schemas and typed clients",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "octoload": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.js"
    },
    "./react-router": {
      "types": "./dist/adapters/react-router.d.ts",
      "import": "./dist/adapters/react-router.js",
      "require": "./dist/adapters/react-router.js"
    },
    "./nextjs": {
      "types": "./dist/adapters/nextjs.d.ts",
      "import": "./dist/adapters/nextjs.js",
      "require": "./dist/adapters/nextjs.js"
    }
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:compile",
    "build:clean": "rm -rf dist",
    "build:compile": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build"
  },
  "keywords": [
    "image",
    "upload",
    "drizzle",
    "s3",
    "r2",
    "cloudflare",
    "presigned-url",
    "typescript",
    "cli",
    "react-router",
    "nextjs",
    "file-upload",
    "direct-upload",
    "multipart",
    "storage"
  ],
  "author": "KahWee Teng <tengkahwee@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kahwee/octoload#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/octoload.git"
  },
  "bugs": {
    "url": "https://github.com/kahwee/octoload/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "commander": "^12.1.0",
    "drizzle-kit": "^0.29.0",
    "drizzle-orm": "^0.38.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^15.14.0",
    "next": "^15.5.3",
    "prettier": "^3.4.2",
    "react-router": "^7.8.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "drizzle-kit": "^0.29.0",
    "drizzle-orm": "^0.38.0"
  },
  "files": [
    "dist/**/*",
    "templates/**/*",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ]
}
